{
  "name": "site-weblyft-design",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "main": "worker.js",
  "run_worker_first": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "weblyftgo.online",
      "custom_domain": true
    },
    {
      "pattern": "www.weblyftgo.online",
      "custom_domain": true
    }
  ]
}
