{
  "version": 3,
  "routes": [
    {
      "src": "^/about$",
      "dest": "/about.html"
    },
    {
      "src": "^/contact$",
      "dest": "/contact.html"
    },
    {
      "src": "^/gallery$",
      "dest": "/gallery.html"
    },
    {
      "src": "^/services$",
      "dest": "/services.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}